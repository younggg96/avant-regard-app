# =====================================================
# .dockerignore - keep production image small
# =====================================================

# Git
.git
.gitignore
.github

# Python
__pycache__
**/__pycache__
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments (CRITICAL: must match actual folder names)
.env
.env.*
!.env.example
.venv
venv
env
ENV

# Local secret / backup files
.env copy
*.env.local
*.env.bak

# IDE / editor
.idea
.vscode
*.swp
*.swo

# Testing / coverage
.pytest_cache
.coverage
.coverage.*
htmlcov/
.tox
.nox
.mypy_cache
.ruff_cache

# Build artifacts
*.egg-info
dist/
build/
pip-wheel-metadata/

# Docker meta (not needed inside the image)
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Documentation / non-runtime
*.md
docs/

# One-off migration / maintenance scripts (should not ship to prod)
scripts/migrate_memfire_to_supabase/

# Local dev helpers
run.py

# Misc
.DS_Store
*.log
logs/
tmp/
