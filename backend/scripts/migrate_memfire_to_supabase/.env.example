# Copy this file to .env and fill in real values.
# Never commit .env — it contains service-role keys that bypass RLS.

# --- Source (MemFire Cloud — used only to read the bucket list) ---
SOURCE_SUPABASE_URL=https://d61omf0g91hgk1gnp7i0.baseapi.memfiredb.com
SOURCE_SUPABASE_SERVICE_KEY=

# --- Target (new Supabase project, e.g. Singapore region) ---
TARGET_SUPABASE_URL=
TARGET_SUPABASE_SERVICE_KEY=
# Optional: Supabase "Connection string" (Project Settings → Database).
# When set, the script applies the schema automatically via psql. Otherwise
# you paste the SQL into the Supabase SQL Editor manually.
TARGET_POSTGRES_URL=

# --- Tunables ---
MIGRATION_DRY_RUN=0
