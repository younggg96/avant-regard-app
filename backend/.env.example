# =====================================================
# Avant Regard API - 环境配置
# 完全使用 Supabase Auth 认证
# =====================================================

# =====================================================
# Supabase 配置
# =====================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# =====================================================
# Redis 配置（可选，用于速率限制和缓存）
# =====================================================
REDIS_URL=redis://localhost:6379/0

# =====================================================
# 服务器配置
# =====================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:19006","exp://localhost:8081"]

# =====================================================
# 支付通道
# =====================================================
# 默认 provider — 留空时 OrderService 在创建订单时按 mock 起 stub intent;
# 业务侧 startPayment 会根据 currency 走 factory.resolve_provider 切换通道,
# 因此 PAYMENT_PROVIDER 主要影响初始 hold + 开发联调。
# 可选值: stripe / alipay / wechat / mock
PAYMENT_PROVIDER=stripe

# 即便默认 provider 不是 mock,这个开关会在 payment-options 列表里附加 mock,
# 仅供 staging 联调使用,生产环境务必留空。
# PAYMENT_ENABLE_MOCK=1

# ----- Stripe(海外区主通道,US/EU/...) -----
# 优先使用 Restricted API Key (rk_xxx) 而不是 sk_live_xxx
# 创建路径: Dashboard → Developers → API keys → Restricted keys
# 至少需要 PaymentIntents (write) + Refunds (write) + Webhook Endpoints (read)
STRIPE_API_KEY=
# 在 Dashboard → Webhooks 里给 https://YOUR_DOMAIN/api/webhooks/stripe 创建 endpoint 后获得
# 必须订阅: payment_intent.succeeded / payment_intent.payment_failed / charge.refunded
STRIPE_WEBHOOK_SECRET=
# Connect 平台账号 id(可选,仅 Connect 场景需要)
# STRIPE_ACCOUNT_ID=acct_xxx

# Stripe Connect Onboarding 跳转 URL(开启卖家自动放款时必填)
#
# Stripe 强制要求 https; 自定义 scheme(avantregard://...) 它不接受。
# 后端已经内置一对极简跳板页(GET HTML), 只是把 https 跳到 avantregard:// :
#   - /api/connect/return    onboarding 完成后跳转(成功路径)
#   - /api/connect/refresh   onboarding 链接过期 / 用户中途取消时跳转
# 把 YOUR_DOMAIN 替换成 backend 对外 https 域名即可,无需另外搭前端站。
# 内嵌的 <script> 自动跳到 expo-web-browser 监听的 redirectUrl
# (avantregard://connect/return), iOS ASWebAuthenticationSession /
# Android Custom Tabs 看到 scheme 切换会自动 dismiss 把控制交回 App。
STRIPE_CONNECT_REFRESH_URL=https://api.avantregards.com/connect/refresh
STRIPE_CONNECT_RETURN_URL=https://api.avantregards.com/connect/return

# ----- 支付宝 App 支付(国内 CNY) -----
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://api.avantregards.com/webhooks/alipay

# ----- 微信支付 v3(国内 CNY) -----
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_NOTIFY_URL=https://api.avantregards.com/webhooks/wechat

# =====================================================
# 数字护照 · AI 三视图生成
# =====================================================
# 由一张单品照生成正 / 侧 / 背三张棚拍图。两家模型可选:
#
#   wan    阿里云百炼 · 通义万相(默认)。国内直连,鉴权复用下面的
#          QWEN_API_KEY,不需要任何额外基础设施。
#   openai gpt-image。国内服务器直连 api.openai.com 不通,必须先按
#          下面的说明搭好境外反代再切过来。
#
# 换模型只改这一个值,改完跑 scripts/passport_preflight 看「上游连通性」。
THREE_VIEW_PROVIDER=wan

# --- 万相 (provider=wan 时生效) ---
WAN_IMAGE_MODEL=wan2.7-image-pro
# 编辑场景支持 1K / 2K。2K 单张 5MB+,App 要加载三张、公开页还要再来一遍,
# 对档案影像是纯浪费;1K 约 1.5MB。
WAN_IMAGE_SIZE=1K
WAN_IMAGE_TIMEOUT=100
WAN_CONNECT_TIMEOUT=10

# --- OpenAI (provider=openai 时生效) ---
# 未配置时 POST /api/passport/three-view 直接返回 503,不做静默降级。
OPENAI_API_KEY=
# 国内机器直连 api.openai.com 不通 —— 而且不是报错,是连接阶段挂住,
# 表现为前端「请求超时」。生产在腾讯云上海,必须填反代网关地址,
# 形如 https://openai-relay.你的域名.com/v1 (结尾的 /v1 不能少)。
#
# 搭反代的三个坑:
#   1. 别用香港节点,OpenAI 不向香港提供服务,会被判 unsupported_country
#      能用的是东京 / 新加坡 / 美西
#   2. nginx 必须开 proxy_ssl_server_name,否则 TLS 握手直接失败
#   3. nginx 的 proxy_read_timeout 要大于 OPENAI_IMAGE_TIMEOUT,
#      否则先断的是 nginx,后端的真实错误又被吞掉
#
# 改完在服务器上跑 scripts/passport_preflight 确认「上游连通性」为绿。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
# 单张实测 ~20s,三张并发;超时给足否则白花钱拿不到图。
OPENAI_IMAGE_TIMEOUT=100
# 连接超时单列且要短：生成慢是正常的，但"连不上"不该也等满读超时。
OPENAI_CONNECT_TIMEOUT=10
# 每用户每天可生成几组三视图(一组 = 三张 = 三次计费)。
THREE_VIEW_DAILY_LIMIT=5
