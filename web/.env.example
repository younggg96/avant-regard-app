# Base URL of the Avant Regard backend API (FastAPI).
# In production: https://api.avantregard.com
NEXT_PUBLIC_API_BASE_URL=https://api.avantregard.com

# Public site URL (used for canonical tags / OpenGraph).
NEXT_PUBLIC_SITE_URL=https://avantregard.com

# Store URLs used by the /download page.
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/avant-regard/id0000000000
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.avantregard
