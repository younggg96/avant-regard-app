# ----------------------------------------------------------------------------
# China flavor (默认 / 中国版) — 配合 `npm run start:cn` / `npm run ios:cn` 使用。
#
# 此文件是模板，请复制为 .env.cn 并填入真实 secrets：
#   cp .env.cn.example .env.cn
# .env.cn 本身不入库（.gitignore 已忽略），仅本地使用。
# ----------------------------------------------------------------------------

# 中国版后端 API
EXPO_PUBLIC_API_BASE_URL=https://api.avantregard.com

# 微信开放平台 AppID (wx 开头) — 中国版才需要，注册地址 https://open.weixin.qq.com/
EXPO_PUBLIC_WECHAT_APP_ID=
# iOS Universal Link，必须与微信开放平台后台配置完全一致，末尾带斜杠
# 例如: https://app.avantregard.com/wechat/
EXPO_PUBLIC_WECHAT_UNIVERSAL_LINK=

# Stripe Publishable Key — 开发用 pk_test_，生产用 pk_live_
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
