{
  "expo": {
    "name": "Avant Regard",
    "slug": "avant-regard",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpg",
    "userInterfaceStyle": "light",
    "scheme": "avantregard",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Avant Regard 需要访问您的相册，以便您选择照片或视频用于发布穿搭分享、单品测评等帖子内容，或更换个人头像和封面图片。",
        "NSCameraUsageDescription": "Avant Regard 需要使用您的相机，以便您拍摄穿搭照片用于发布帖子内容，例如拍摄今日穿搭并分享到社区。",
        "NSPhotoLibraryAddUsageDescription": "Avant Regard 需要将您编辑后的图片或分享的内容海报保存到您的相册中。",
        "NSLocationWhenInUseUsageDescription": "Avant Regard 需要获取您的位置信息，以便在地图上为您展示附近的买手店，例如查找您周边的设计师品牌集合店。",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "LSApplicationQueriesSchemes": [
          "weixin",
          "weixinULAPI",
          "sinaweibo",
          "sinaweibohd"
        ]
      },
      "bundleIdentifier": "com.yanggg96.avant-regard",
      "associatedDomains": ["applinks:app.avantregard.com"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.jpg",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "com.yanggg96.avantregard",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.avantregard.com",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "app.avantregard.com",
              "pathPrefix": "/share"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/logo.jpg"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000",
          "sounds": [],
          "defaultChannel": "default"
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "3e890188-f159-4285-81fb-790e46fce869"
      }
    }
  }
}
