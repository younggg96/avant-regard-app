# API 配置
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# 营销/合规站点 (Privacy Policy、Terms 等公开页面)
# 中国版: https://avantregard.com    北美版: https://avantregards.com
EXPO_PUBLIC_WEB_URL=https://avantregard.com

# 微信开放平台 AppID (wx 开头)
# 注册地址: https://open.weixin.qq.com/
EXPO_PUBLIC_WECHAT_APP_ID=
# iOS Universal Link，必须与微信开放平台后台配置完全一致，末尾带斜杠
# 例如: https://app.avantregard.com/wechat/
EXPO_PUBLIC_WECHAT_UNIVERSAL_LINK=

# Stripe Publishable Key
# 后台: https://dashboard.stripe.com/apikeys
# dev/test 环境用 pk_test_..., 生产用 pk_live_...
# Publishable key 允许出现在客户端代码中，但对应的 sk_live_/sk_test_ 只能放后端
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
