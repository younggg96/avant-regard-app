# ----------------------------------------------------------------------------
# North America flavor (北美版 / NA) — 配合 `npm run start:na` / `npm run ios:na`
# 使用。对应 EAS profile `production-na`，bundleId 带 `.na` 后缀，scheme 是
# `avantregardna`。微信/微博跳转不启用。
#
# 此文件是模板，请复制为 .env.na 并填入真实 secrets：
#   cp .env.na.example .env.na
# .env.na 本身不入库（.gitignore 已忽略），仅本地使用。
# ----------------------------------------------------------------------------

# 北美版后端 API
EXPO_PUBLIC_API_BASE_URL=https://api.avantregards.com

# 北美版不接入微信，留空即可（保留 key 让 react-native-dotenv 不抱怨缺字段）
EXPO_PUBLIC_WECHAT_APP_ID=
EXPO_PUBLIC_WECHAT_UNIVERSAL_LINK=

# Stripe Publishable Key — 开发用 pk_test_，生产用 pk_live_
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
