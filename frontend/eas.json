{
  "cli": {
    "version": ">= 16.13.3",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.avantregard.com"
      }
    },
    "production-na": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "na",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.avantregards.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "avantregard6@gmail.com",
        "ascAppId": "6756938671",
        "companyName": "Shanghai Nanteke Industrial Co., Ltd."
      }
    },
    "production-na": {
      "ios": {
        "appleId": "avantregard6@gmail.com",
        "ascAppId": "6769261192",
        "companyName": "Shanghai Nanteke Industrial Co., Ltd."
      }
    }
  }
}
